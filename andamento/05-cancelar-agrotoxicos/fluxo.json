        "sourceCode": {
          "code": "export const code = async (inputs) => {\n  const { answers = {}, serviceSlug, submittedAt, userId } = inputs.dados ?? {};\n  const a = answers;\n  const recebidoEm = submittedAt ?? new Date().toISOString();\n  const dataMS = new Date(new Date(recebidoEm).getTime() - 4 * 3600 * 1000).toISOString().slice(0, 10).replace(/-/g, '');\n  const protocolo = 'CAG-' + dataMS + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();\n  const motivos = {\n    nao_comercializa: 'Não vende agrotóxicos',\n    lei_2951: 'Não vai continuar vendendo (Lei Estadual 2.951/2004)',\n    nao_transporta: 'Não transporta agrotóxicos',\n    nao_aplica: 'Não presta serviço de aplicação',\n  };\n  const nomeArquivo = (v) => (Array.isArray(v) ? v[0]?.name : '') ?? '';\n  return {\n    protocolo,\n    recebidoEm,\n    situacao: 'Recebido',\n    nome: a.nome_completo ?? '',\n    email: a.email ?? '',\n    razaoSocial: a.razao_social ?? '',\n    cnpj: a.cnpj ?? '',\n    inscricaoEstadual: a.inscricao_estadual ?? '',\n    municipio: a.municipio ?? '',\n    uf: a.uf ?? '',\n    motivo: motivos[a.motivo_cancelamento] ?? '',\n    cartaoCnpj: nomeArquivo(a.arquivo_cartao_cnpj),\n    guiaRecolhimento: nomeArquivo(a.arquivo_guia_recolhimento),\n    servico: serviceSlug ?? '',\n    usuario: userId ?? 'não informado',\n  };\n};",
          "packageJson": "{}"
        },
        "propertySettings": {
