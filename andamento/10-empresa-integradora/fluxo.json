        "sourceCode": {
          "code": "export const code = async (inputs) => {\n  const { answers = {}, serviceSlug, submittedAt, userId } = inputs.dados ?? {};\n  const a = answers;\n  const recebidoEm = submittedAt ?? new Date().toISOString();\n  const dataMS = new Date(new Date(recebidoEm).getTime() - 4 * 3600 * 1000).toISOString().slice(0, 10).replace(/-/g, '');\n  const protocolo = 'INT-' + dataMS + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();\n  const tipos = { cadastro: 'Cadastro novo', atualizacao: 'Atualização' };\n  const atividades = { avicultura: 'Avicultura', suinocultura: 'Suinocultura' };\n  return {\n    protocolo,\n    recebidoEm,\n    situacao: 'Recebido',\n    tipoPedido: tipos[a.tipo_pedido] ?? '',\n    representante: a.nome_representante_legal ?? '',\n    emailRepresentante: a.email_representante ?? '',\n    razaoSocial: a.razao_social ?? '',\n    nomeFantasia: a.nome_fantasia ?? '',\n    cnpj: a.cnpj ?? '',\n    inscricaoEstadual: a.inscricao_estadual ?? '',\n    atividade: atividades[a.atividade_integradora] ?? '',\n    emailEmpresa: a.email_empresa ?? '',\n    municipio: a.municipio ?? '',\n    uf: a.uf ?? '',\n    servico: serviceSlug ?? '',\n    usuario: userId ?? 'não informado',\n  };\n};",
          "packageJson": "{}"
        },
        "propertySettings": {
          "dados": {
            "type": "MANUAL"
          }
        },
