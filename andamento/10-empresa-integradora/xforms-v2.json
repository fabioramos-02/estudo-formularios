{
  "title": "Cadastrar ou atualizar empresa integradora de aves ou suínos",
  "description": "Para empresas integradoras da criação de aves (avicultura) ou de suínos (suinocultura) em Mato Grosso do Sul. O cadastro é feito na IAGRO (Agência Estadual de Defesa Sanitária Animal e Vegetal).",
  "pages": [
    {
      "name": "pedido",
      "title": "O que você quer fazer",
      "elements": [
        {
          "type": "radiogroup",
          "name": "tipo_pedido",
          "isRequired": true,
          "requiredErrorText": "Escolha uma opção para continuar.",
          "title": "Você quer",
          "choices": [
            {
              "value": "cadastro",
              "text": "Fazer o cadastro da empresa pela primeira vez"
            },
            {
              "value": "atualizacao",
              "text": "Atualizar um cadastro que já existe"
            }
          ]
        }
      ]
    },
    {
      "name": "representante",
      "title": "Representante legal da empresa",
      "description": "Quem responde pela empresa.",
      "elements": [
        {
          "type": "text",
          "name": "nome_representante_legal",
          "isRequired": true,
          "requiredErrorText": "Preencha o nome do representante legal para continuar.",
          "title": "Nome completo do representante legal"
        },
        {
          "type": "text",
          "name": "telefone_representante",
          "isRequired": true,
          "requiredErrorText": "Digite o telefone com DDD, 11 números.",
          "title": "Telefone do representante",
          "inputType": "tel",
          "maskType": "pattern",
          "maskSettings": {
            "pattern": "(99) 99999-9999"
          },
          "placeholder": "(00) 00000-0000",
          "validators": [
            {
              "type": "regex",
              "regex": "^\\(?\\d{2}\\)?\\s?\\d{5}-?\\d{4}$",
              "text": "Digite o telefone com DDD, 11 números."
            }
          ]
        },
        {
          "type": "text",
          "name": "email_representante",
          "isRequired": true,
          "requiredErrorText": "Preencha o e-mail para continuar.",
          "title": "E-mail",
          "inputType": "email",
          "placeholder": "nome@empresa.com.br",
          "validators": [
            {
              "type": "email",
              "text": "Digite um e-mail no formato nome@dominio."
            }
          ],
          "startWithNewLine": false,
          "tooltip": "A resposta do cadastro chega neste e-mail."
        }
      ]
    },
    {
