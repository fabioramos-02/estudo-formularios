        "sourceCode": {
          "code": "export const code = async (inputs) => {\n  const { answers = {}, serviceSlug, submittedAt, userId } = inputs.dados ?? {};\n  const a = answers;\n  const recebidoEm = submittedAt ?? new Date().toISOString();\n  const dataMS = new Date(new Date(recebidoEm).getTime() - 4 * 3600 * 1000).toISOString().slice(0, 10).replace(/-/g, '');\n  const protocolo = 'SOQ-' + dataMS + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();\n  const areas = {\n    ate_50_hectares: 'Até 50 hectares',\n    acima_50_hectares: 'Mais de 50 hectares',\n  };\n  const nomeArquivo = (v) => (Array.isArray(v) ? v[0]?.name : '') ?? '';\n  return {\n    protocolo,\n    recebidoEm,\n    situacao: 'Recebido',\n    nome: a.nome_completo ?? '',\n    email: a.email ?? '',\n    areaPlantio: areas[a.area_plantio] ?? '',\n    relatorioFiscalizacao: nomeArquivo(a.arquivo_relatorio_fiscalizacao),\n    guiaDaems: nomeArquivo(a.arquivo_guia_daems),\n    comprovantePagamento: nomeArquivo(a.arquivo_comprovante_pagamento),\n    servico: serviceSlug ?? '',\n    usuario: userId ?? 'não informado',\n  };\n};",
          "packageJson": "{}"
        },
        "propertySettings": {
