{
  "title": "Cadastrar indústria de agrotóxicos no e-Saniagro",
  "description": "Para indústrias de agrotóxicos que precisam de cadastro no e-Saniagro, o sistema da IAGRO (Agência Estadual de Defesa Sanitária Animal e Vegetal). Pode ser feito pela própria empresa ou por uma consultoria que a represente.",
  "pages": [
    {
      "name": "solicitante",
      "title": "Quem está fazendo o pedido",
      "elements": [
        {
          "type": "radiogroup",
          "name": "perfil_solicitante",
          "isRequired": true,
          "requiredErrorText": "Escolha uma opção para continuar.",
          "title": "Você é",
          "tooltip": "Quem representa a indústria anexa uma procuração no fim do formulário.",
          "choices": [
            {
              "value": "empresa",
              "text": "Da própria indústria"
            },
            {
              "value": "consultoria",
              "text": "De consultoria ou empresa de registros que representa a indústria"
            }
          ]
        },
        {
          "type": "text",
          "name": "nome_completo",
          "isRequired": true,
          "requiredErrorText": "Preencha o nome completo para continuar.",
          "title": "Seu nome completo",
          "autocomplete": "name",
          "tooltip": "Vem da sua conta. A IAGRO fala com você sobre este cadastro."
        },
        {
          "type": "text",
          "name": "email",
          "isRequired": true,
          "requiredErrorText": "Preencha o e-mail para continuar.",
          "title": "E-mail",
          "inputType": "email",
          "autocomplete": "email",
          "placeholder": "nome@empresa.com.br",
          "validators": [
            {
              "type": "email",
              "text": "Digite um e-mail no formato nome@dominio."
            }
          ],
          "tooltip": "A resposta do cadastro chega neste e-mail."
        },
        {
          "type": "text",
          "name": "telefone_celular",
          "isRequired": true,
          "requiredErrorText": "Digite o celular com DDD, 11 números.",
          "title": "Celular",
          "startWithNewLine": false,
          "inputType": "tel",
          "autocomplete": "tel",
          "maskType": "pattern",
          "maskSettings": {
            "pattern": "(99) 99999-9999"
          },
          "placeholder": "(00) 00000-0000"
        }
      ]
    },
    {
      "name": "industria",
      "title": "Sobre a indústria",
      "elements": [
        {
          "type": "text",
          "name": "cnpj",
          "isRequired": true,
          "requiredErrorText": "Digite o CNPJ com 14 números.",
          "title": "CNPJ",
          "description": "Cadastro Nacional da Pessoa Jurídica da indústria.",
          "maskType": "pattern",
          "maskSettings": {
            "pattern": "99.999.999/9999-99"
          },
          "placeholder": "00.000.000/0000-00",
          "validators": [
            {
              "type": "regex",
              "regex": "^\\d{2}\\.?\\d{3}\\.?\\d{3}/?\\d{4}-?\\d{2}$",
              "text": "Digite o CNPJ com 14 números."
            }
          ]
        },
        {
          "type": "text",
          "name": "razao_social",
          "isRequired": true,
          "requiredErrorText": "Preencha a razão social para continuar.",
          "title": "Razão social",
          "description": "O nome da empresa no CNPJ."
        },
        {
          "type": "text",
          "name": "nome_representante_legal",
          "isRequired": true,
          "requiredErrorText": "Preencha o nome do representante legal para continuar.",
          "title": "Nome do representante legal",
          "description": "Quem responde pela indústria, como consta no contrato social."
        }
      ]
    },
    {
      "name": "endereco",
      "title": "Endereço para correspondência",
      "elements": [
        {
          "type": "text",
          "name": "cep",
          "isRequired": true,
          "requiredErrorText": "Digite o CEP com 8 números.",
          "title": "CEP",
          "autocomplete": "postal-code",
          "maskType": "pattern",
          "maskSettings": {
            "pattern": "99999-999"
          },
          "placeholder": "00000-000"
        },
        {
          "type": "text",
          "name": "logradouro",
          "isRequired": true,
          "requiredErrorText": "Preencha o endereço para continuar.",
          "title": "Endereço",
          "description": "Rua, número e complemento.",
          "autocomplete": "street-address"
        },
        {
          "type": "text",
          "name": "bairro",
          "isRequired": true,
          "requiredErrorText": "Preencha o bairro para continuar.",
          "title": "Bairro"
        },
        {
          "type": "text",
          "name": "municipio",
          "isRequired": true,
          "requiredErrorText": "Preencha o município para continuar.",
          "title": "Município",
