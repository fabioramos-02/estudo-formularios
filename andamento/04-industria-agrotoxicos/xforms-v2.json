    {
      "name": "documentos",
      "title": "Documentos",
      "description": "Arquivos em PDF, até 5 MB cada.",
      "elements": [
        {
          "type": "file",
          "name": "arquivo_cartao_cnpj",
          "title": "Comprovante de inscrição no CNPJ",
          "description": "O cartão CNPJ, emitido no site da Receita Federal.",
          "isRequired": true,
          "requiredErrorText": "Anexe o comprovante do CNPJ para continuar.",
          "acceptedTypes": ".pdf",
