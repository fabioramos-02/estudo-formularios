          "requiredErrorText": "Anexe a procuração para continuar.",
          "acceptedTypes": ".pdf",
          "maxSize": 5242880,
          "storeDataAsText": true,
          "allowMultiple": false,
          "waitForUpload": true,
          "visibleIf": "{perfil_solicitante} = 'consultoria'",
          "requiredIf": "{perfil_solicitante} = 'consultoria'"
