        "sampleData": {},
        "sourceCode": {
          "code": "export const code = async (inputs) => {\n  const { answers = {}, serviceSlug, submittedAt, userId } = inputs.dados ?? {};\n  const a = answers;\n  const recebidoEm = submittedAt ?? new Date().toISOString();\n  const dataMS = new Date(new Date(recebidoEm).getTime() - 4 * 3600 * 1000).toISOString().slice(0, 10).replace(/-/g, '');\n  const protocolo = 'VET-' + dataMS + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();\n  const tipos = { cadastro: 'Cadastro novo', atualizacao: 'Atualização' };\n  const nomesArquivos = (v) => (Array.isArray(v) ? v.map((f) => f?.name).filter(Boolean).join('; ') : '');\n  const vinculada = a.empresa_vinculada === 'sim';\n  return {\n    protocolo,\n    recebidoEm,\n    situacao: 'Recebido',\n    tipoPedido: tipos[a.tipo_pedido] ?? '',\n    nome: a.nome_completo ?? '',\n    email: a.email ?? '',\n    crmv: a.numero_crmv ?? '',\n    municipio: a.municipio ?? '',\n    uf: a.uf ?? '',\n    empresaVinculada: vinculada ? 'Sim' : 'Não',\n    cnpjEmpresa: a.cnpj_empresa ?? '',\n    empresa: a.razao_social_empresa ?? '',\n    portariaMapa: a.numero_portaria_mapa ?? '',\n    comprovanteVinculo: nomesArquivos(a.arquivo_vinculo_empresa),\n    arquivoPortariaMapa: nomesArquivos(a.arquivo_portaria_mapa),\n    servico: serviceSlug ?? '',\n    usuario: userId ?? 'não informado',\n  };\n};",
          "packageJson": "{}"
        },
        "propertySettings": {
          "dados": {
            "type": "MANUAL"
          }
        },
        "errorHandlingOptions": {
          "retryOnFailure": {
            "value": false
          },
          "continueOnFailure": {
            "value": false
          }
        }
      },
