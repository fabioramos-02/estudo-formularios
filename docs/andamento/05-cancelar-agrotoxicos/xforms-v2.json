{
  "title": "Cancelar registro de empresa de agrotóxicos na IAGRO",
  "description": "Para empresas que vendem, transportam ou aplicam agrotóxicos e querem encerrar o registro na IAGRO (Agência Estadual de Defesa Sanitária Animal e Vegetal).",
  "pages": [
    {
      "name": "responsavel",
      "title": "Responsável pela empresa",
      "elements": [
        {
          "type": "text",
          "name": "nome_completo",
          "isRequired": true,
          "requiredErrorText": "Preencha o nome completo para continuar.",
          "title": "Seu nome completo",
          "autocomplete": "name",
          "description": "Quem responde pela empresa e assina este pedido.",
          "tooltip": "Vem da sua conta. Corrija se estiver diferente do documento."
        },
        {
          "type": "text",
          "name": "cpf",
          "isRequired": true,
          "requiredErrorText": "Digite um CPF válido, com 11 números.",
          "title": "CPF",
          "description": "Cadastro de Pessoa Física.",
          "autocomplete": "cpf",
          "maskType": "pattern",
          "maskSettings": {
            "pattern": "999.999.999-99"
          },
          "placeholder": "000.000.000-00",
          "validators": [
            {
              "type": "regex",
              "regex": "^\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}$",
              "text": "Digite um CPF com 11 números."
            }
          ],
          "tooltip": "Vem da sua conta."
        },
        {
          "type": "text",
          "name": "email",
          "isRequired": true,
          "requiredErrorText": "Preencha o e-mail para continuar.",
          "title": "E-mail",
          "inputType": "email",
          "autocomplete": "email",
          "placeholder": "nome@empresa.com.br",
          "validators": [
            {
              "type": "email",
              "text": "Digite um e-mail no formato nome@dominio."
            }
          ],
          "tooltip": "A resposta do pedido chega neste e-mail."
        }
      ]
    },
    {
      "name": "empresa",
      "title": "Sobre a empresa",
      "elements": [
        {
          "type": "text",
          "name": "razao_social",
          "isRequired": true,
          "requiredErrorText": "Preencha o nome da empresa para continuar.",
          "title": "Nome da empresa",
          "description": "Como está no CNPJ (razão social)."
        },
        {
          "type": "text",
          "name": "cnpj",
          "isRequired": true,
          "requiredErrorText": "Digite o CNPJ com 14 números.",
          "title": "CNPJ",
          "description": "Cadastro Nacional da Pessoa Jurídica.",
          "maskType": "pattern",
          "maskSettings": {
            "pattern": "99.999.999/9999-99"
          },
          "placeholder": "00.000.000/0000-00",
          "validators": [
            {
              "type": "regex",
              "regex": "^\\d{2}\\.?\\d{3}\\.?\\d{3}/?\\d{4}-?\\d{2}$",
              "text": "Digite o CNPJ com 14 números."
            }
          ]
        },
        {
          "type": "text",
          "name": "inscricao_estadual",
          "isRequired": true,
          "requiredErrorText": "Preencha a inscrição estadual para continuar.",
