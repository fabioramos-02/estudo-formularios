        "sampleData": {},
        "sourceCode": {
          "code": "export const code = async (inputs) => {\n  const { answers = {}, serviceSlug, submittedAt, userId } = inputs.dados ?? {};\n  const a = answers;\n  const recebidoEm = submittedAt ?? new Date().toISOString();\n  const dataMS = new Date(new Date(recebidoEm).getTime() - 4 * 3600 * 1000).toISOString().slice(0, 10).replace(/-/g, '');\n  const protocolo = 'FUN-' + dataMS + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();\n  const tipos = { diarias: 'Diárias', passagens: 'Passagens', ambos: 'Diárias e passagens' };\n  const arquivo = Array.isArray(a.arquivo_documento_pessoal) ? a.arquivo_documento_pessoal[0]?.name : '';\n  return {\n    protocolo,\n    recebidoEm,\n    situacao: 'Recebido',\n    vinculo: a.vinculo === 'estagiario' ? 'Estagiário' : 'Servidor',\n    nome: a.nome_completo ?? '',\n    email: a.email ?? '',\n    matricula: a.matricula ?? '',\n    tipo: tipos[a.tipo_solicitacao] ?? '',\n    origem: a.cidade_origem ?? '',\n    destino: a.cidade_destino ?? '',\n    dataIda: a.data_saida ?? '',\n    dataVolta: a.data_retorno ?? '',\n    objetivo: a.objetivo_viagem ?? '',\n    veiculo: a.veiculo_utilizado ?? '',\n    documento: arquivo ?? '',\n    dadosBancarios: a.vinculo === 'estagiario' ? 'Nas respostas do X-Forms' : 'No sistema de RH',\n    servico: serviceSlug ?? '',\n    usuario: userId ?? 'não informado',\n  };\n};",
          "packageJson": "{}"
        },
        "propertySettings": {
          "dados": {
            "type": "MANUAL"
          }
        },
        "errorHandlingOptions": {
