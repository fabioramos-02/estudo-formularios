{
  "title": "Pedir o Selo Arte",
  "description": "Para quem produz alimentos de origem animal de forma artesanal e quer o Selo Arte para os seus produtos.",
  "pages": [
    {
      "name": "solicitante",
      "title": "Quem está fazendo o pedido",
      "elements": [
        {
          "type": "text",
          "name": "nome_completo",
          "isRequired": true,
          "requiredErrorText": "Preencha o nome completo para continuar.",
          "title": "Seu nome completo",
          "autocomplete": "name",
          "tooltip": "Vem da sua conta. Corrija se estiver diferente do documento."
        },
        {
          "type": "text",
          "name": "cpf",
          "isRequired": true,
          "requiredErrorText": "Digite um CPF válido, com 11 números.",
          "title": "CPF",
          "description": "Cadastro de Pessoa Física.",
          "autocomplete": "cpf",
          "maskType": "pattern",
          "maskSettings": {
            "pattern": "999.999.999-99"
          },
          "placeholder": "000.000.000-00",
          "validators": [
            {
              "type": "regex",
              "regex": "^\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}$",
              "text": "Digite um CPF com 11 números."
            }
          ],
          "tooltip": "Vem da sua conta."
        },
        {
          "type": "text",
          "name": "email",
          "isRequired": true,
          "requiredErrorText": "Preencha o e-mail para continuar.",
          "title": "E-mail",
          "inputType": "email",
          "autocomplete": "email",
          "placeholder": "nome@exemplo.com.br",
          "validators": [
            {
              "type": "email",
              "text": "Digite um e-mail no formato nome@dominio."
            }
          ],
          "tooltip": "A resposta do pedido chega neste e-mail."
        }
      ]
    },
    {
      "name": "estabelecimento",
      "title": "Sobre o estabelecimento",
      "elements": [
        {
          "type": "text",
          "name": "nome_estabelecimento",
          "isRequired": true,
          "requiredErrorText": "Preencha o nome do estabelecimento para continuar.",
          "title": "Nome do estabelecimento",
          "description": "Onde os produtos são fabricados."
        },
        {
          "type": "text",
          "name": "registro_servico_inspecao",
          "isRequired": true,
          "requiredErrorText": "Preencha o serviço de inspeção para continuar.",
          "title": "Serviço de inspeção em que o estabelecimento é registrado"
        },
        {
          "type": "text",
          "name": "numero_registro",
          "isRequired": true,
          "requiredErrorText": "Preencha o número do registro para continuar.",
          "title": "Número do registro",
          "description": "O número no serviço de inspeção."
