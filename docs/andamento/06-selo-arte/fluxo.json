        "sourceCode": {
          "code": "export const code = async (inputs) => {\n  const { answers = {}, serviceSlug, submittedAt, userId } = inputs.dados ?? {};\n  const a = answers;\n  const recebidoEm = submittedAt ?? new Date().toISOString();\n  const dataMS = new Date(new Date(recebidoEm).getTime() - 4 * 3600 * 1000).toISOString().slice(0, 10).replace(/-/g, '');\n  const protocolo = 'ART-' + dataMS + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();\n  const nomeArquivo = (v) => (Array.isArray(v) ? v[0]?.name : '') ?? '';\n  return {\n    protocolo,\n    recebidoEm,\n    situacao: 'Recebido',\n    nome: a.nome_completo ?? '',\n    email: a.email ?? '',\n    estabelecimento: a.nome_estabelecimento ?? '',\n    servicoInspecao: a.registro_servico_inspecao ?? '',\n    numeroRegistro: a.numero_registro ?? '',\n    municipio: a.municipio ?? '',\n    produtos: a.produtos ?? '',\n    declaracao: (a.declaracao_ciencia ?? []).includes('ciente') ? 'Aceita' : '',\n    logomarca: nomeArquivo(a.arquivo_logomarca),\n    servico: serviceSlug ?? '',\n    usuario: userId ?? 'não informado',\n  };\n};",
          "packageJson": "{}"
        },
        "propertySettings": {
          "dados": {
            "type": "MANUAL"
          }
        },
