{
  "title": "Cadastrar ou atualizar laboratório de diagnóstico em sanidade avícola",
  "description": "Para laboratórios que fazem análises de saúde das aves para os programas oficiais de monitoramento sanitário. O cadastro é feito na IAGRO (Agência Estadual de Defesa Sanitária Animal e Vegetal).",
  "pages": [
    {
      "name": "pedido",
      "title": "O que você quer fazer",
      "elements": [
        {
          "type": "radiogroup",
          "name": "tipo_pedido",
          "isRequired": true,
          "requiredErrorText": "Escolha uma opção para continuar.",
          "title": "Você quer",
          "choices": [
            {
              "value": "cadastro",
              "text": "Fazer o cadastro do laboratório pela primeira vez"
            },
            {
              "value": "atualizacao",
              "text": "Atualizar um cadastro que já existe"
            }
          ]
        }
      ]
    },
    {
      "name": "solicitante",
      "title": "Quem está fazendo o pedido",
      "elements": [
        {
          "type": "text",
          "name": "nome_completo",
          "isRequired": true,
          "requiredErrorText": "Preencha o nome completo para continuar.",
          "title": "Seu nome completo",
          "autocomplete": "name",
          "tooltip": "Vem da sua conta. Corrija se estiver diferente do documento."
        }
      ]
    },
    {
      "name": "laboratorio",
      "title": "Sobre o laboratório",
      "elements": [
        {
          "type": "text",
          "name": "razao_social",
          "isRequired": true,
          "requiredErrorText": "Preencha a razão social para continuar.",
          "title": "Razão social",
          "description": "Como está no CNPJ."
        },
        {
          "type": "text",
          "name": "nome_fantasia",
          "isRequired": true,
          "requiredErrorText": "Preencha o nome fantasia para continuar.",
          "title": "Nome fantasia"
        },
        {
          "type": "text",
          "name": "cnpj",
          "isRequired": true,
          "requiredErrorText": "Digite o CNPJ com 14 números.",
          "title": "CNPJ",
          "description": "Cadastro Nacional da Pessoa Jurídica.",
          "maskType": "pattern",
          "maskSettings": {
            "pattern": "99.999.999/9999-99"
          },
          "placeholder": "00.000.000/0000-00",
          "validators": [
            {
              "type": "regex",
              "regex": "^\\d{2}\\.?\\d{3}\\.?\\d{3}/?\\d{4}-?\\d{2}$",
              "text": "Digite o CNPJ com 14 números."
            }
          ]
        },
        {
          "type": "text",
          "name": "inscricao_estadual",
          "isRequired": true,
          "requiredErrorText": "Preencha a inscrição estadual para continuar.",
          "title": "Inscrição estadual",
          "startWithNewLine": false
        },
        {
          "type": "text",
          "name": "telefone_laboratorio",
          "isRequired": true,
          "requiredErrorText": "Digite o telefone com DDD.",
          "title": "Telefone do laboratório",
          "inputType": "tel",
          "placeholder": "(00) 0000-0000",
          "validators": [
            {
              "type": "regex",
              "regex": "^\\(?\\d{2}\\)?\\s?\\d{4,5}-?\\d{4}$",
              "text": "Digite o telefone com DDD, 10 ou 11 números."
            }
          ]
        },
        {
          "type": "text",
          "name": "email_laboratorio",
          "isRequired": true,
          "requiredErrorText": "Preencha o e-mail para continuar.",
          "title": "E-mail do laboratório",
          "startWithNewLine": false,
          "inputType": "email",
          "placeholder": "nome@laboratorio.com.br",
          "validators": [
            {
              "type": "email",
              "text": "Digite um e-mail no formato nome@dominio."
            }
          ],
          "tooltip": "A resposta do cadastro chega neste e-mail."
        }
      ]
    },
    {
      "name": "analises",
      "title": "Análises e credenciamento",
      "elements": [
        {
          "type": "comment",
          "name": "escopo_analises",
          "title": "Que análises o laboratório faz em aves? (opcional)",
          "description": "Por exemplo: Salmonela, Micoplasma. Escreva também outros tipos de teste.",
          "maxLength": 1000
        },
        {
          "type": "radiogroup",
          "name": "credenciado_mapa",
          "isRequired": true,
          "requiredErrorText": "Escolha Sim ou Não para continuar.",
          "title": "O laboratório é credenciado no MAPA?",
          "description": "MAPA é o Ministério da Agricultura e Pecuária.",
          "choices": [
            {
              "value": "sim",
              "text": "Sim"
            },
            {
              "value": "nao",
              "text": "Não"
            }
          ]
        },
        {
          "type": "text",
          "name": "numero_portaria_credenciamento",
          "visibleIf": "{credenciado_mapa} = 'sim'",
          "requiredIf": "{credenciado_mapa} = 'sim'",
          "requiredErrorText": "Preencha o número da portaria para continuar.",
          "title": "Número da portaria de credenciamento no MAPA"
        },
        {
          "type": "text",
          "name": "numero_crl",
          "title": "Número do CRL (opcional)",
          "description": "Se o laboratório tiver."
        }
      ]
    },
    {
      "name": "endereco",
      "title": "Onde fica o laboratório",
      "elements": [
        {
          "type": "text",
          "name": "cep",
          "isRequired": true,
          "requiredErrorText": "Digite o CEP com 8 números.",
          "title": "CEP",
          "autocomplete": "postal-code",
          "maskType": "pattern",
          "maskSettings": {
            "pattern": "99999-999"
          },
          "placeholder": "00000-000",
          "validators": [
            {
              "type": "regex",
              "regex": "^\\d{5}-?\\d{3}$",
              "text": "Digite o CEP com 8 números."
            }
          ]
        },
        {
          "type": "text",
          "name": "logradouro",
          "visibleIf": "{cep} notempty",
          "requiredIf": "{cep} notempty",
          "requiredErrorText": "Preencha o endereço para continuar.",
          "title": "Endereço",
          "description": "Rua, número e bairro.",
          "autocomplete": "street-address"
        },
        {
          "type": "text",
          "name": "municipio",
          "visibleIf": "{cep} notempty",
          "requiredIf": "{cep} notempty",
          "requiredErrorText": "Preencha o município para continuar.",
          "title": "Município"
        },
        {
          "type": "dropdown",
          "name": "uf",
          "visibleIf": "{cep} notempty",
          "requiredIf": "{cep} notempty",
          "requiredErrorText": "Escolha o estado para continuar.",
          "title": "Estado",
          "startWithNewLine": false,
          "placeholder": "Selecione",
          "choices": [
