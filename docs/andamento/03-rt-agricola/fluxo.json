        "sourceCode": {
          "code": "export const code = async (inputs) => {\n  const { answers = {}, serviceSlug, submittedAt, userId } = inputs.dados ?? {};\n  const a = answers;\n  const recebidoEm = submittedAt ?? new Date().toISOString();\n  const dataMS = new Date(new Date(recebidoEm).getTime() - 4 * 3600 * 1000).toISOString().slice(0, 10).replace(/-/g, '');\n  const protocolo = 'RTA-' + dataMS + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();\n  const objetivos = { estabelecimento_insumos: 'Estabelecimentos de insumos', cultivo_soja_algodao: 'Cultivos de soja ou algodão' };\n  const nomeArquivo = (v) => (Array.isArray(v) ? v[0]?.name : '') ?? '';\n  return {\n    protocolo,\n    recebidoEm,\n    situacao: 'Recebido',\n    nome: a.nome_completo ?? '',\n    email: a.email ?? '',\n    objetivo: (a.objetivo_cadastro ?? []).map((o) => objetivos[o] ?? o).join('; '),\n    docIdentidade: nomeArquivo(a.arquivo_documento_identidade),\n    carteiraConselho: nomeArquivo(a.arquivo_carteira_conselho),\n    comprovanteResidencia: nomeArquivo(a.arquivo_comprovante_residencia),\n    servico: serviceSlug ?? '',\n    usuario: userId ?? 'não informado',\n  };\n};",
          "packageJson": "{}"
        },
        "propertySettings": {
          "dados": {
            "type": "MANUAL"
          }
        },
