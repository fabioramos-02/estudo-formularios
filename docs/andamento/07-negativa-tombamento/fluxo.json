        "sourceCode": {
          "code": "export const code = async (inputs) => {\n  const { answers = {}, serviceSlug, submittedAt, userId } = inputs.dados ?? {};\n  const a = answers;\n  const recebidoEm = submittedAt ?? new Date().toISOString();\n  const dataMS = new Date(new Date(recebidoEm).getTime() - 4 * 3600 * 1000).toISOString().slice(0, 10).replace(/-/g, '');\n  const protocolo = 'TOM-' + dataMS + '-' + Math.random().toString(36).slice(2, 8).toUpperCase();\n  const nomeArquivo = (v) => (Array.isArray(v) ? v.map((f) => f?.name).filter(Boolean).join(', ') : '');\n  return {\n    protocolo,\n    recebidoEm,\n    situacao: 'Recebido',\n    nome: a.nome_completo ?? '',\n    email: a.email ?? '',\n    perfil: a.perfil_solicitante === 'representante' ? 'Representante do proprietário' : 'Proprietário',\n    imovel: a.identificacao_imovel ?? '',\n    certidaoMatricula: nomeArquivo(a.arquivo_certidao_matricula),\n    documentoRequerente: nomeArquivo(a.arquivo_documento_requerente),\n    documentoProprietario: nomeArquivo(a.arquivo_documento_proprietario),\n    procuracao: nomeArquivo(a.arquivo_procuracao),\n    servico: serviceSlug ?? '',\n    usuario: userId ?? 'não informado',\n  };\n};",
          "packageJson": "{}"
        },
        "propertySettings": {
